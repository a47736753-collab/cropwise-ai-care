# ─── Supabase (https://supabase.com/dashboard → Project Settings → API) ───
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe for the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for `npm run setup` (bucket creation, migrations, seeding).
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google Gemini (https://aistudio.google.com/apikey) ───
# Powers the AI leaf diagnosis.
GEMINI_API_KEY=

# ─── Optional ───
# OpenAI (fallback engine, not currently used)
OPENAI_API_KEY=
# OpenWeatherMap (weather-aware alerts, not yet wired up)
OPENWEATHER_API_KEY=

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# After filling in the keys above:
#   npm run setup   → creates storage bucket, applies migrations, seeds data
#   npm run build && npm start
